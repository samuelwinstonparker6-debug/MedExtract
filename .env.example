# MedExtract V2 Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# For local development (default): SQLite (no extra setup required)
DATABASE_URL=sqlite:///./medextract.db

# For production: PostgreSQL
# DATABASE_URL=postgresql://medextract:yourpassword@localhost:5432/medextract

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Required for async document processing in production.
# Local dev falls back to threading if Redis is not running.
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random value in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=dev-insecure-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Wildcard '*' is never used — explicit origins only.
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000

# ── Docker only ───────────────────────────────────────────────────────────────
# Used by docker-compose.yml to set the PostgreSQL password.
POSTGRES_PASSWORD=medextract_secret

# ── Algorithm Thresholds ──────────────────────────────────────────────────────
# Optional — defaults are tuned for the V2 fingerprint algorithm.
FRAUD_AMBER_THRESHOLD=0.75
FRAUD_RED_THRESHOLD=0.88

# ── Upload ────────────────────────────────────────────────────────────────────
# MAX_UPLOAD_SIZE is in bytes. Default: 10 MB.
# MAX_UPLOAD_SIZE=10485760

# ── Tesseract (Windows local dev only — not needed in Docker) ─────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
